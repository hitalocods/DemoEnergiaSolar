# Conexão com o Neon Postgres
DATABASE_URL=postgresql://neondb_owner:SENHA@ep-xyz-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# Chave secreta de autenticação (mínimo 32 caracteres)
AUTH_SECRET=gere_uma_chave_secreta_longa_e_aleatoria_aqui

# Credenciais do usuário inicial para o seed (obrigatórias para rodar npm run db:seed)
SEED_EMAIL=rafael@solarmais.com.br
SEED_PASSWORD=gere_uma_senha_forte_para_o_consultor_aqui

# WhatsApp Cloud API (Meta Developers)
WHATSAPP_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=100000000000000
WHATSAPP_VERIFY_TOKEN=token_secreto_para_validar_webhook_na_meta
WHATSAPP_APP_SECRET=app_secret_do_painel_meta
WHATSAPP_API_VERSION=v23.0
# Se true, simula envios da Meta no console sem chamar a API externa (útil para testes locais)
WHATSAPP_DRY_RUN=true
ECO_TESTE=false

# Inteligência Artificial / Agente de Qualificação
IA_ATIVA=true
# Provedor de IA: "mock" (gratuito para testes) ou "anthropic" (Claude)
IA_PROVIDER=mock

# Vercel Blob (para armazenar imagens de contas de energia recebidas)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
